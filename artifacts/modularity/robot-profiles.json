{
  "g1": {
    "schema_version": 1,
    "id": "g1",
    "label": "Unitree G1 humanoid",
    "adapter": "robot_eval.simulation:G1Simulation",
    "adapter_options": {},
    "root_body": "pelvis",
    "floor_geom": "floor",
